# /etc/kronwerke-bot/bot.env, mode 640, owner root, group kronwerke-bot.

# The bot token from the Discord developer portal (Bot, Reset Token). Required.
DISCORD_TOKEN=PASTE_THE_TOKEN_HERE

# Where state.json, update.trial and update.skip live.
KW_STATE_DIR=/srv/projects/kronwerke-bot/state

# Health and Prometheus metrics, loopback only. Port block 13030 on kvm-45.
KW_HTTP_ADDR=127.0.0.1:13030

# Self updates from GitHub releases. "off" turns them off.
KW_UPDATE_REPO=kronwerke/bot

# The Minecraft server for the status message (Server List Ping, no password).
# Empty until the Season 2 server runs.
KW_MC_ADDR=

# RCON for whitelist sync and the goal board. Empty until the Season 2 server runs.
# Use a long random password, and allow the RCON port only from this server's address.
KW_RCON_ADDR=
KW_RCON_PASSWORD=
